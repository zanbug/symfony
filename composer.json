{
    "name": "zanbug/symfony",
    "description": "Zanbug error & monitoring SDK — Symfony bundle that auto-captures exceptions.",
    "type": "symfony-bundle",
    "keywords": [
        "zanbug",
        "error-monitoring",
        "symfony",
        "error-tracking",
        "monitoring",
        "exceptions"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Zanbug",
            "email": "dev@zanbug.com"
        }
    ],
    "require": {
        "php": ">=7.1",
        "zanbug/php-sdk": "^2.0.0",
        "symfony/http-kernel": ">=3.4",
        "symfony/dependency-injection": ">=3.4",
        "symfony/config": ">=3.4",
        "symfony/event-dispatcher": ">=3.4"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../php-sdk"
        }
    ],
    "autoload": {
        "psr-4": {
            "Zanbug\\Symfony\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "homepage": "https://zanbug.com",
    "support": {
        "issues": "https://github.com/zanbug/symfony/issues",
        "docs": "https://zanbug.com/integrations/symfony",
        "source": "https://github.com/zanbug/symfony"
    }
}
